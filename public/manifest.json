{
  "manifest_version": 3,
  "name": "Pocket PT 站点导入",
  "version": "0.2.2",
  "description": "从已登录的 PT 站点生成 Pocket PT 导入二维码",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "cookies", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "打开 Pocket PT 站点导入"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
