{
  "manifest_version": 3,
  "name": "Pocket Qt 站点导入插件",
  "version": "0.4.0",
  "description": "从已登录的 PT 站点生成 Pocket Qt 导入二维码",
  "minimum_chrome_version": "132",
  "permissions": ["tabs", "scripting", "cookies", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "打开 Pocket Qt 站点导入插件"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
